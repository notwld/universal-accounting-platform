# ============================================================
# APPLICATION
# ============================================================
APP_NAME=universal-accounting-api
APP_ENV=development
APP_VERSION=2.0.0
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=dev-only-change-me-in-production
DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — exact origins only (never * with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# POSTGRESQL (optional — defaults to sqlite)
# ============================================================
# DATABASE_URL=postgres://uap:uap@localhost:5432/uap
# Runtime app role (no SUPERUSER / BYPASSRLS / table ownership):
# DATABASE_URL=postgres://uap_app:uap_app@localhost:5432/uap

# ============================================================
# REDIS (optional — defaults to locmem cache)
# ============================================================
# REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ============================================================
# CLERK
# ============================================================
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWT_KEY=  # optional PEM for local verify without JWKS fetch
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_VERIFY_AUTHORIZED_PARTY=true
CLERK_CLOCK_SKEW_MS=5000

# ============================================================
# SMTP — app security notifications only (Clerk owns auth email)
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=security@example.com
SECURITY_NOTIFY_EMAIL_ENABLED=true

# ============================================================
# APPLICATION SECURITY
# ============================================================
PII_HMAC_KEY=change-me-hmac
# FIELD_ENCRYPTION_KEY=  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_SESSION_PROJECTION_ENABLED=true
AUTH_REQUIRE_CONTEXT_FOR_TENANT_APIS=true
IDEMPOTENCY_ENABLED=true
AUDIT_HASH_IP_ADDRESSES=true
AUDIT_HASH_USER_AGENTS=true

AUTH_BOOTSTRAP_RATE_LIMIT=30/m
AUTH_ME_RATE_LIMIT=180/m
AUTH_CONTEXT_RATE_LIMIT=120/m
AUTH_CONTEXT_SWITCH_RATE_LIMIT=30/m
AUTH_SECURITY_EVENTS_RATE_LIMIT=30/m
AUTH_SESSIONS_RATE_LIMIT=60/m

# DB tuning (Postgres)
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
PROVIDER_EVENT_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=90

# Observability (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_ENABLED=false
OTEL_SERVICE_NAME=universal-accounting-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_PII=false
